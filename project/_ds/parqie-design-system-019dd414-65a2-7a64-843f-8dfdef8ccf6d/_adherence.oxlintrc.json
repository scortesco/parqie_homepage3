{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/driver-app/**",
              "ui_kits/partner/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-fg",
      "--bg",
      "--bg-elevated",
      "--bg-inverse",
      "--bg-inverse-2",
      "--border",
      "--border-strong",
      "--danger",
      "--dur-1",
      "--dur-2",
      "--dur-3",
      "--ease-emph",
      "--ease-standard",
      "--fg-1",
      "--fg-2",
      "--fg-3",
      "--fg-on-dark",
      "--fg-on-lime",
      "--font-sans",
      "--fw-bold",
      "--fw-medium",
      "--fw-regular",
      "--fw-semibold",
      "--fz-body",
      "--fz-body-sm",
      "--fz-caption",
      "--fz-display",
      "--fz-h1",
      "--fz-h2",
      "--fz-h3",
      "--lh-normal",
      "--lh-relaxed",
      "--lh-tight",
      "--pq-black",
      "--pq-dark-green",
      "--pq-grey",
      "--pq-grey-text",
      "--pq-lime",
      "--pq-pure-white",
      "--pq-red",
      "--pq-true-black",
      "--pq-white",
      "--r-card",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--shadow-lg",
      "--shadow-lime",
